# Copy to repository-root .env. Node loads it only on the server.
ALLWEAVE_PORT=8787
# Defaults to this repository. Windows uses semicolons; Linux/macOS use colons.
# ALLWEAVE_ROOTS=D:/project/allweave;D:/projects/another-project
# ALLWEAVE_DATA_DIR=D:/project/allweave/.allweave
# Optional model configuration directory; defaults to .allweave/agent.
# ALLWEAVE_AGENT_DIR=C:/Users/your-user/.allweave/agent
# Set to off to disable optional tool providers.
# ALLWEAVE_MCP=off
# ALLWEAVE_CODEMODE=off
# Optional environment-based credentials. API keys can also be configured in the web interface.
# Never put credentials in VITE_* variables.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
