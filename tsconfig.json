{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@allweave/telemetry": [
				"./packages/telemetry/src/index.ts"
			],
			"@allweave/telemetry/testing": [
				"./packages/telemetry/src/testing/index.ts"
			],
			"@allweave/sandbox": [
				"./packages/sandbox/src/index.ts"
			],
			"@allweave/sandbox/declarations": [
				"./packages/sandbox/src/declarations.ts"
			],
			"@allweave/sandbox/source": [
				"./packages/sandbox/src/source.ts"
			],
			"@allweave/sandbox/worker": [
				"./packages/sandbox/src/runtime/worker.ts"
			],
			"@allweave/model": [
				"./packages/model/src/index.ts"
			],
			"@allweave/model/oauth": [
				"./packages/model/src/oauth.ts"
			],
			"@allweave/model/*": [
				"./packages/model/src/*.ts",
				"./packages/model/src/providers/*.ts"
			],
			"@allweave/model/dist/*": [
				"./packages/model/src/*"
			],
			"@allweave/protocol": [
				"./packages/protocol/src/index.ts"
			],
			"@allweave/kernel": [
				"./packages/kernel/src/index.ts"
			],
			"@allweave/kernel-adapters": [
				"./packages/kernel-adapters/src/index.ts"
			],
			"@allweave/kernel/*": [
				"./packages/kernel/src/*"
			],
			"@allweave/protocol/*": [
				"./packages/protocol/src/*"
			],
			"typebox": [
				"./node_modules/typebox"
			]
		}
	},
	"include": [
		"scripts/model-catalog-protocol.ts",
		"scripts/model-catalog-protocol.test.ts",
		"packages/*/src/**/*",
		"packages/*/test/**/*"
	]
}
