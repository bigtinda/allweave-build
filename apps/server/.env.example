# Copy to repository-root .env. Node loads it only on the server.
PI_CONSOLE_PORT=8787
# Defaults to this repository. Windows uses semicolons; Linux/macOS use colons.
# PI_CONSOLE_ROOTS=D:/project/pi-main;D:/projects/another-project
# PI_CONSOLE_DATA_DIR=D:/project/pi-main/.pi-console
# Optional stable console access token (32+ characters). Otherwise generated on startup.
# PI_CONSOLE_TOKEN=replace-with-a-random-long-local-access-token
# Optional Pi release archive path; defaults to the repository-root release zip.
# PI_CONSOLE_KERNEL_ZIP=D:/project/pi-main/pi-windows-x64.zip
# Optional Pi configuration directory; defaults to .pi-console/agent.
# PI_CODING_AGENT_DIR=C:/Users/your-user/.pi/agent
# Optional environment-based credentials. API keys can also be configured in the web interface.
# Never put credentials in VITE_* variables.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
